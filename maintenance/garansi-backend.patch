+// Hitung status untuk respons/tampilan tanpa mengubah riwayat garansi.
+function statusGaransiEfektif_(status, tanggalHabis, waktuSekarang) {
+    var statusTersimpan = String(status || '').trim();
+    if (statusTersimpan !== 'Aktif' || !tanggalHabis) return statusTersimpan;
+    var akhir = new Date(tanggalHabis);
+    var sekarang = waktuSekarang == null ? new Date() : new Date(waktuSekarang);
+    return !isNaN(akhir.getTime()) && sekarang.getTime() > akhir.getTime()
+        ? 'Habis (Expired)' : statusTersimpan;
+}
